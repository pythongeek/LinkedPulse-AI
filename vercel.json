{
  "version": 2,
  "buildCommand": "npx prisma generate --schema=./backend/prisma/schema.prisma && vite build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
