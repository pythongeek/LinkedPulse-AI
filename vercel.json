{
  "version": 2,
  "buildCommand": "npx prisma generate --schema=./backend/prisma/schema.prisma && vite build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "backend/src/assets/fonts/**"
    }
  }
}
