generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  linkedinCookies String?  @map("linkedin_cookies")
  linkedinProfile Json?    @map("linkedin_profile")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  
  // Relations
  personas            Persona[]
  contents            Content[]
  audits              ProfileAudit[]
  topicAlerts         TopicAlert[]
  usageStats          UsageStats?
  competitorProfiles  CompetitorProfile[]
  topicWatchlist      TopicWatchlist[]
  
  @@map("users")
}


model Persona {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  jobRole         String   @map("job_role")
  expertiseNodes  String[] @map("expertise_nodes")
  experienceVault String   @map("experience_vault") @db.Text
  tone            String
  visualDNA       Json     @map("visual_dna")
  systemPrompt    String   @map("system_prompt") @db.Text
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("personas")
}

model Topic {
  id                String   @id @default(uuid())
  keyword           String   @unique
  opportunityScore  Float?   @map("opportunity_score")
  trendData         Json?    @map("trend_data")
  competitionData   Json?    @map("competition_data")
  linkedinData      Json?    @map("linkedin_data")
  normalizedKeyword String?  @map("normalized_keyword")
  b2bRelevanceScore Float?   @map("b2b_relevance_score")
  velocity7d        Float?
  peakPredictedAt   DateTime? @map("peak_predicted_at")
  contentAngleMap   Json?    @map("content_angle_map")
  isEstimated       Boolean  @default(false) @map("is_estimated")
  dataLastRefreshed DateTime? @map("data_last_refreshed")
  lastAnalyzed      DateTime? @map("last_analyzed")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  
  // Relations
  contents    Content[]
  competitors CompetitorPost[]
  researchRuns TopicResearchRun[]
  signals      TopicSignal[]
  
  @@map("topics")
}

model Content {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  topicId           String?  @map("topic_id")
  personaId         String?  @map("persona_id")
  contentType       String   @map("content_type")
  title             String?
  body              String   @db.Text
  outline           Json?
  researchData      Json?    @map("research_data")
  sources           Json?
  images            String[]
  status            String   @default("draft")
  engagementPrediction Float? @map("engagement_prediction")
  seoScore          Float?   @map("seo_score")
  hookSuggestions   Json?    @map("hook_suggestions")
  bestPostingTime   String?  @map("best_posting_time")
  linkedinOptimization Json? @map("linkedin_optimization")
  competitiveAnalysis Json?  @map("competitive_analysis")
  scheduledFor      DateTime? @map("scheduled_for")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  
  // Structured per-content-type fields
  slides            Json?    @map("slides")            // CarouselSlide[]
  firstComment      String?  @map("first_comment") @db.Text
  hookFormula       String?  @map("hook_formula")
  charCount         Int?     @map("char_count")
  wordCount         Int?     @map("word_count")
  pollQuestion      String?  @map("poll_question")
  pollOptions       Json?    @map("poll_options")      // PollOption[]
  pollDuration      String?  @map("poll_duration")
  articleTitle      String?  @map("article_title")
  articleExcerpt    String?  @map("article_excerpt")

  // New research quality & verification fields
  researchQuality    Int?     @map("research_quality")    // 0-100
  dataSourceCount    Int?     @map("data_source_count")   // how many real sources
  isAiGrounded       Boolean  @default(false) @map("is_ai_grounded")
  topicSignal        Json?    @map("topic_signal")        // Reddit/community data
  engagementActual   Json?    @map("engagement_actual")   // Real post performance
  publishedUrn       String?  @map("published_urn")       // LinkedIn post URN

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id])
  
  @@map("contents")
}

model CompetitorPost {
  id              String    @id @default(uuid())
  topicId         String    @map("topic_id")
  author          String
  authorProfile   String?   @map("author_profile")
  authorFollowers Int?      @map("author_followers")
  authorJobTitle  String?   @map("author_job_title")
  content         String    @db.Text
  hookText        String?   @map("hook_text") @db.Text
  contentFormat   String    @default("text") @map("content_format")
  likes           Int       @default(0)
  comments        Int       @default(0)
  shares          Int       @default(0)
  impressions     Int?
  engagementRate  Float?    @map("engagement_rate")
  viralScore      Float?    @map("viral_score")
  wordCount       Int?      @map("word_count")
  emojiCount      Int?      @map("emoji_count")
  hashtagsUsed    String[]  @map("hashtags_used")
  hasMedia        Boolean   @default(false) @map("has_media")
  hasLink         Boolean   @default(false) @map("has_link")
  ctaPresent      Boolean   @default(false) @map("cta_present")
  dayOfWeek       Int?      @map("day_of_week")
  hourPosted      Int?      @map("hour_posted")
  postUrl         String?   @map("post_url")
  postedAt        DateTime? @map("posted_at")
  analyzedAt      DateTime  @default(now()) @map("analyzed_at")
  dataSource      String    @default("ai") @map("data_source")

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, postedAt])
  @@index([topicId, engagementRate])
  @@map("competitor_posts")
}

model CompetitorProfile {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  linkedinUrl     String    @map("linkedin_url")
  name            String
  jobTitle        String?   @map("job_title")
  followers       Int?
  postFrequency   Float?    @map("post_frequency")
  avgEngagement   Float?    @map("avg_engagement")
  topFormats      Json?     @map("top_formats")
  topHashtags     Json?     @map("top_hashtags")
  lastScanned     DateTime? @map("last_scanned")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("competitor_profiles")
}

model AnalysisSnapshot {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  topicKeyword    String    @map("topic_keyword")
  snapshotData    Json      @map("snapshot_data")
  postCount       Int       @map("post_count")
  avgEngagement   Float?    @map("avg_engagement")
  topGaps         String[]  @map("top_gaps")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId, topicKeyword])
  @@map("analysis_snapshots")
}

model ProfileAudit {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  headline        String?
  about           String?  @db.Text
  bannerUrl       String?  @map("banner_url")
  profileUrl      String?  @map("profile_url")
  auditScore      Float?   @map("audit_score")
  seoScore        Float?   @map("seo_score")
  brandScore      Float?   @map("brand_score")
  gaps            Json?
  suggestions     Json?
  topCreators     Json?    @map("top_creators")
  industryTrends  Json?    @map("industry_trends")
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("profile_audits")
}

model TopicAlert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  topic       String
  alertType   String   @map("alert_type")
  message     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("topic_alerts")
}

model UsageStats {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  contentsGenerated   Int      @default(0) @map("contents_generated")
  topicsResearched    Int      @default(0) @map("topics_researched")
  imagesCreated       Int      @default(0) @map("images_created")
  apiCalls            Int      @default(0) @map("api_calls")
  lastReset           DateTime @default(now()) @map("last_reset")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("usage_stats")
}

model ResearchCache {
  id          String   @id @default(uuid())
  query       String
  queryType   String   @map("query_type")
  results     Json
  source      String
  sourceTier  Int      @default(2) @map("source_tier")
  hitCount    Int      @default(0) @map("hit_count")
  lastHitAt   DateTime? @map("last_hit_at")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([query, queryType])
  @@map("research_cache")
}

model TopicResearchRun {
  id             String   @id @default(uuid())
  topicId        String   @map("topic_id")
  runAt          DateTime @default(now()) @map("run_at")
  signals        Json
  computed       Json
  dataFreshness  Json     @map("data_freshness")
  qualityScore   Int      @map("quality_score")
  sourceCount    Int      @map("source_count")
  isB2bContext   Boolean  @default(true) @map("is_b2b_context")
  createdAt      DateTime @default(now()) @map("created_at")
  
  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@map("topic_research_runs")
}

model TopicSignal {
  id             String   @id @default(uuid())
  topicId        String   @map("topic_id")
  signalType     String   @map("signal_type")
  source         String
  rawValue       Json     @map("raw_value")
  normalizedScore Float?  @map("normalized_score")
  capturedAt     DateTime @default(now()) @map("captured_at")
  expiresAt      DateTime @map("expires_at")
  
  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  @@map("topic_signals")
}

model ScrapingJob {
  id          String   @id @default(uuid())
  jobType     String   @map("job_type")
  status      String   @default("pending")
  params      Json
  result      Json?
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("scraping_jobs")
}

model LinkedInSession {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  liAt        String?  @map("li_at")
  jsessionId  String?  @map("jsession_id")
  isActive    Boolean  @default(true) @map("is_active")
  lastUsed    DateTime @default(now()) @map("last_used")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  accessToken String?  @map("access_token")
  refreshToken String? @map("refresh_token")
  clientId     String?  @map("client_id")
  clientSecret String?  @map("client_secret")
  selectedAuthorUrn String?  @map("selected_author_urn") // e.g. urn:li:person:123 or urn:li:organization:456
  managedPages      Json?    @map("managed_pages")       // Cache of [{ urn, name }]
  
  @@map("linkedin_sessions")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model QueuedJob {
  id                String    @id @default(uuid())
  type              String    // e.g., "CONTENT_GENERATION", "TREND_ANALYSIS"
  status            JobStatus @default(PENDING)
  phase             Int       @default(0)    // Current phase (for chunked processing)
  totalPhases       Int       @default(1)    // Total phases needed
  payload           Json      // Input parameters
  intermediateResult Json?    // Partial results between phases
  result            Json?     // Final output result
  error             String?   // Error message
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  priority          Int       @default(0)
  runAt             DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  
  @@map("queued_jobs")
}

model ApiHealthLog {
  id            String   @id @default(uuid())
  apiName       String   @map("api_name")
  isAvailable   Boolean  @map("is_available")
  responseTimeMs Int?    @map("response_time_ms")
  errorCode     String?  @map("error_code")
  checkedAt     DateTime @default(now()) @map("checked_at")
  
  @@map("api_health_logs")
}

model TopicWatchlist {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  keyword         String
  contentType     String?   @map("content_type")
  topicType       String?   @map("topic_type")
  audienceSegment String?   @map("audience_segment")
  alertThreshold  Int       @default(70) @map("alert_threshold")
  isActive        Boolean   @default(true) @map("is_active")
  lastChecked     DateTime? @map("last_checked")
  latestScore     Float?    @map("latest_score")
  latestVelocity  String?   @map("latest_velocity")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("topic_watchlist")
}

